<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="8dp">

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Hari pembayaran"/>
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <com.google.android.material.chip.Chip android:id="@+id/chip_d0" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sen"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_d1" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sel"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_d2" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rab"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_d3" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kam"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_d4" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jum"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_d5" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sab"/>
            <com.google.android.material.chip.Chip android:id="@+id/chip_d6" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Min"/>
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:hint="Nominal per pembayaran (Rp)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="number" android:maxLength="9"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView android:id="@+id/tv_target" style="@style/Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <TextView style="@style/Label" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Zona waktu"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/zone_group"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            app:selectionRequired="true" app:singleSelection="true">
            <com.google.android.material.chip.Chip android:id="@+id/z_wib" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIB"/>
            <com.google.android.material.chip.Chip android:id="@+id/z_wita" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WITA"/>
            <com.google.android.material.chip.Chip android:id="@+id/z_wit" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WIT"/>
        </com.google.android.material.chip.ChipGroup>

        <TextView android:id="@+id/tv_note" style="@style/Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:visibility="gone"
            android:text="Perubahan berlaku mulai Senin depan. Kewajiban yang sudah ada tidak berubah."/>

        <TextView android:id="@+id/tv_error"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="@color/status_nunggak"
            android:textSize="14sp" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>