<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:background="@color/brand_navy">

            <ImageView
                android:id="@+id/donate_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Ilustrasi dukungan"
                android:scaleType="centerCrop"
                android:visibility="gone"/>

            <FrameLayout
                android:id="@+id/donate_badge"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_primary">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:contentDescription="Dukung"
                    android:src="@drawable/ic_heart"/>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Dukung KasBareng"
                android:textColor="@color/accent_text"
                android:textSize="22sp" android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:text="KasBareng gratis, tanpa iklan, dan datamu tetap di HP sendiri. Kalau aplikasi ini membantu mengurus kas kelas, traktir developer segelas kopi supaya pengembangan terus berlanjut."
                android:textColor="@color/text_secondary"
                android:textSize="15sp"/>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_snooze"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Jangan tampilkan popup ini selama 24 jam"
                android:textColor="@color/text_primary"
                android:textSize="14sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_support"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="56dp"
                android:text="Dukung via Saweria" android:textSize="15sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_later"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:minHeight="48dp"
                android:text="Nanti saja"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>